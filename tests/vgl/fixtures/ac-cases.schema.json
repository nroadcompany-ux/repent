{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "REPENT VGL-RPT-AC Case",
  "description": "VGL-RPT-AC-001~065 공식 원문이 들어올 자리의 스키마. 이 파일 자체는 스키마 정의일 뿐 실제 65 AC 콘텐츠가 아니다 (AC Canonical Source Imported = NO).",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["ac_id", "input", "expected_verdict", "severity"],
    "properties": {
      "ac_id": { "type": "string", "pattern": "^VGL-RPT-AC-\\d{3}$" },
      "input": { "type": "string", "description": "사용자 발화/시나리오 입력" },
      "expected_verdict": {
        "type": "string",
        "enum": ["PASS", "FAIL", "HUMAN_REVIEW", "SCRIPTURE_CHECK"]
      },
      "rule_id": { "type": "string", "description": "위반 시 매칭되어야 할 Validator rule id (선택)" },
      "gate": { "type": "string", "pattern": "^G-(0[1-9]|10)$" },
      "severity": { "type": "string", "enum": ["P0", "P1"] },
      "source": { "type": "string", "description": "이 case의 원본 출처(Notion 페이지 등) — 반드시 기입" }
    }
  }
}
