# RETURN — Environment Variable Names Only.
# NEVER commit real values. Copy to .env.local for development and register the
# real values in the Vercel Project Environment Variables dashboard for production.

# ---------------------------------------------------------------------------
# Supabase — public (safe to expose to the browser bundle)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase — SERVER ONLY. Must never reach the client bundle.
# Used by the Naver OAuth bridge and by moderation actions.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Naver OAuth — SERVER ONLY.
# Supabase Auth has no built-in Naver provider, so RETURN implements the
# Naver authorization-code flow itself in app/auth/naver/*.
# Register callback URL: <SITE_URL>/auth/naver/callback
# ---------------------------------------------------------------------------
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Anthropic — SERVER ONLY. Client must never call Anthropic directly.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Site
# Absolute origin used to build OAuth redirect URLs.
# Local: http://localhost:3000   Production: https://<your-domain>
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
